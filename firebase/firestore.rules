rules_version = '2';
// Reglas de Firestore de Escapadas. Se copian enteras en la consola de Firebase:
// Firestore Database → Reglas → pegar → Publicar.
//
// - Perfiles: cualquiera con sesión los lee (para ver nombres y caritas); cada uno escribe solo el suyo.
// - Grupos: el id del grupo ES su código de invitación (8 letras/números al azar, no se puede listar ni adivinar).
//   Solo los miembros lo leen. Con el código, uno se puede añadir a sí mismo; cada miembro puede salirse
//   y cambiar el nombre del grupo. Nadie puede añadir ni quitar a otros.
// - Marcas: las leen los miembros del grupo; cada uno escribe y borra solo las suyas ({uid}_{sitioId}).
// - Sitios del grupo: los añade cualquiera; solo su autor los cambia o borra.
// - Planes: los ve el grupo; cada uno se apunta o se borra a sí mismo; quien propone lo edita o lo cancela;
//   el plan B lo pone o cambia cualquiera del grupo.
service cloud.firestore {
  match /databases/{database}/documents {
    function dentro() { return request.auth != null; }
    function yo() { return request.auth.uid; }
    function esMiembro(gid) {
      return dentro() && yo() in get(/databases/$(database)/documents/grupos/$(gid)).data.miembros;
    }
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    function nombreValido(n, max) { return n is string && n.size() > 0 && n.size() <= max; }

    match /perfiles/{uid} {
      allow read: if dentro();
      allow create, update: if dentro() && yo() == uid
        && request.resource.data.keys().hasOnly(['nombre', 'emoji', 'color', 'actualizado'])
        && nombreValido(request.resource.data.nombre, 40)
        && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 16
        && request.resource.data.color is string && request.resource.data.color.size() <= 16;
      allow delete: if dentro() && yo() == uid;
    }

    match /grupos/{gid} {
      allow read: if dentro() && yo() in resource.data.miembros;
      allow create: if dentro() && gid.size() >= 8
        && request.resource.data.keys().hasOnly(['nombre', 'codigoInvitacion', 'miembros', 'creadoPor', 'creado'])
        && request.resource.data.codigoInvitacion == gid
        && request.resource.data.miembros == [yo()]
        && request.resource.data.creadoPor == yo()
        && nombreValido(request.resource.data.nombre, 60);
      allow update: if dentro() && (
        // Entrar con el código: añadirse uno mismo y nada más.
        (soloCambia(['miembros']) && !(yo() in resource.data.miembros)
          && request.resource.data.miembros.toSet() == resource.data.miembros.toSet().union([yo()].toSet()))
        // Salir: quitarse uno mismo y nada más.
        || (soloCambia(['miembros']) && yo() in resource.data.miembros
          && request.resource.data.miembros.toSet() == resource.data.miembros.toSet().difference([yo()].toSet()))
        // Cambiar el nombre del grupo: cualquier miembro.
        || (soloCambia(['nombre']) && yo() in resource.data.miembros
          && nombreValido(request.resource.data.nombre, 60))
      );

      match /marcas/{marcaId} {
        allow read: if esMiembro(gid);
        allow create, update: if esMiembro(gid)
          && request.resource.data.uid == yo()
          && marcaId == yo() + '_' + request.resource.data.sitioId
          && request.resource.data.estado in ['quiero', 'fuimos', 'no', '']
          && request.resource.data.estrellas is int
          && request.resource.data.estrellas >= 0 && request.resource.data.estrellas <= 5
          && request.resource.data.nota is string && request.resource.data.nota.size() <= 1000
          && (!('ninos' in request.resource.data) || request.resource.data.ninos is bool);
        allow delete: if esMiembro(gid) && resource.data.uid == yo();
      }

      // Sitios del grupo (guachinches, restaurantes, rincones…): los añade cualquiera del grupo; solo quien lo añadió
      // lo edita o lo borra.
      match /sitios/{sid} {
        function sitioValido(d) {
          return d.keys().hasOnly(['nombre', 'tipo', 'municipio', 'lat', 'lon', 'desc', 'url', 'autor', 'creado', 'actualizado', 'desde', 'hasta'])
            && (!('desde' in d) || (d.desde is string && d.desde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && (!('hasta' in d) || (d.hasta is string && d.hasta.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
            && d.tipo in ['sendero', 'playa', 'mirador', 'pueblo', 'museo', 'naturaleza', 'guachinche', 'restaurante', 'evento', 'curioso']
            && d.municipio is string && d.municipio.size() <= 40
            && d.lat is number && d.lat > 27 && d.lat < 30 && d.lon is number && d.lon > -19 && d.lon < -13
            && d.desc is string && d.desc.size() <= 600 && d.url is string && d.url.size() <= 300
            && d.autor == yo();
        }
        allow read: if esMiembro(gid);
        allow create: if esMiembro(gid) && sitioValido(request.resource.data);
        allow update: if esMiembro(gid) && resource.data.autor == yo() && sitioValido(request.resource.data);
        allow delete: if esMiembro(gid) && resource.data.autor == yo();
      }

      // Disponibilidad: cada uno dice qué días puede (si) y cuáles no (no): 'AAAA-MM-DD' o 'AAAA-MM-DDT' (viernes tarde).
      // (Antes: nopuedo = lista de sábados.) Lo ve el grupo; cada uno escribe el suyo.
      match /disponibilidad/{uid} {
        function listaOk(d, k) { return !(k in d) || (d[k] is list && d[k].size() <= 150); }
        allow read: if esMiembro(gid);
        allow write: if esMiembro(gid) && uid == yo()
          && request.resource.data.keys().hasOnly(['uid', 'nopuedo', 'no', 'si', 'actualizado'])
          && request.resource.data.uid == yo()
          && listaOk(request.resource.data, 'nopuedo') && listaOk(request.resource.data, 'no') && listaOk(request.resource.data, 'si');
      }

      // Planes: cualquiera del grupo propone (y queda apuntado); cada uno se apunta o se borra a sí mismo;
      // quien propone puede cambiar fecha y nota, o cancelarlo.
      match /planes/{planId} {
        // Plan B (opcional): otro sitio de la app o un texto libre.
        function planBValido(d) {
          return !('planB' in d) || (d.planB is map && d.planB.keys().hasOnly(['sitioId', 'destino'])
            && d.planB.get('sitioId', '') is string && d.planB.get('sitioId', '').size() <= 60
            && d.planB.get('destino', '') is string && d.planB.get('destino', '').size() <= 80);
        }
        // Un plan es un sitio del catálogo (sitioId) o un destino libre (destino), en una isla; fecha y, si dura
        // varios días, hasta.
        function planValido(d) {
          return d.sitioId is string && d.sitioId.size() <= 60
            && d.get('destino', '') is string && d.get('destino', '').size() <= 80
            && (d.sitioId.size() > 0 || d.get('destino', '').size() > 0)
            && d.get('isla', 'tenerife') is string && d.get('isla', 'tenerife').size() <= 20
            && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && (d.get('hasta', '') == '' || (d.get('hasta', '') is string && d.get('hasta', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && d.nota is string && d.nota.size() <= 300
            && (!('opciones' in d) || (d.opciones is list && d.opciones.size() <= 3))
            && (!('votos' in d) || d.votos is map)
            && planBValido(d);
        }
        allow read: if esMiembro(gid);
        allow create: if esMiembro(gid)
          && request.resource.data.keys().hasOnly(['sitioId', 'destino', 'isla', 'fecha', 'hasta', 'nota', 'propone', 'apuntados', 'creado', 'planB', 'opciones', 'votos'])
          && request.resource.data.propone == yo() && request.resource.data.apuntados == [yo()]
          && planValido(request.resource.data);
        allow update: if esMiembro(gid) && (
          (soloCambia(['apuntados']) && (
            request.resource.data.apuntados.toSet() == resource.data.apuntados.toSet().union([yo()].toSet())
            || request.resource.data.apuntados.toSet() == resource.data.apuntados.toSet().difference([yo()].toSet())))
          || (resource.data.propone == yo() && soloCambia(['fecha', 'hasta', 'nota', 'opciones', 'votos']) && planValido(request.resource.data))
          // 🗳️ Votar fechas: cada uno cambia solo su voto.
          || (soloCambia(['votos']) && request.resource.data.votos is map
            && request.resource.data.votos.diff(resource.data.get('votos', {})).affectedKeys().hasOnly([yo()]))
          // Plan B: cualquiera del grupo lo pone, lo cambia o lo quita.
          || (soloCambia(['planB']) && planBValido(request.resource.data))
        );
        allow delete: if esMiembro(gid) && resource.data.propone == yo();
      }
    }
  }
}
